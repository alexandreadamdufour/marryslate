# ============================================================
# ENV VARS — copier en .env.local et remplir les valeurs
# Ne jamais committer .env.local
# ============================================================

# --- PUBLIC (exposées côté client) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CRISP_WEBSITE_ID=<website-id>
NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>
NEXT_PUBLIC_BOOKING_AID=<affiliate-id>    # partner.booking.com, no-op si absent
NEXT_PUBLIC_META_PIXEL_ID=<pixel-id>
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=<label>
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<key>

# --- PUBLIC (Stripe) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<key>

# --- PRIVATE (serveur uniquement) ---
CLERK_SECRET_KEY=sk_test_<key>
CLERK_WEBHOOK_SECRET=whsec_<key>

SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

STRIPE_SECRET_KEY=sk_test_<key>
STRIPE_WEBHOOK_SECRET=whsec_<key>    # depuis le dashboard Stripe Webhooks
STRIPE_WEBHOOK_SECRET_CONNECT=

RESEND_API_KEY=re_<key>

# GA4 Measurement Protocol — events serveur (webhook Stripe). VRAI secret,
# contrairement au DSN/AID (GA4 Admin → Data Streams → flux web → Measurement
# Protocol API secrets).
GA_MEASUREMENT_PROTOCOL_API_SECRET=<secret>

# Meta Conversions API — VRAI secret (Events Manager → Conversions API → Generate Access Token)
META_CAPI_ACCESS_TOKEN=<token>

# Sentry — build-time uniquement, upload des source maps (Settings → Auth Tokens, scope project:releases)
SENTRY_AUTH_TOKEN=<token>

# Upstash Redis — rate limiting RSVP (optionnel en local, requis en prod)
# Créer une base Redis sur console.upstash.com → REST API
UPSTASH_REDIS_REST_URL=https://<db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>
