# ============================================================
# ENV VARS — copier en .env.local et remplir les valeurs
# Ne jamais committer .env.local
# ============================================================

# --- PUBLIC (exposées côté client) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CRISP_WEBSITE_ID=<website-id>
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<key>

# --- PUBLIC (Stripe) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<key>

# --- PRIVATE (serveur uniquement) ---
CLERK_SECRET_KEY=sk_test_<key>
CLERK_WEBHOOK_SECRET=whsec_<key>

SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

STRIPE_SECRET_KEY=sk_test_<key>
STRIPE_WEBHOOK_SECRET=whsec_<key>    # depuis le dashboard Stripe Webhooks

RESEND_API_KEY=re_<key>

# Mangopay — obsolète, conservé pour référence
# MANGOPAY_CLIENT_ID=<client-id>
# MANGOPAY_API_KEY=<api-key>
# MANGOPAY_BASE_URL=https://api.sandbox.mangopay.com
# MANGOPAY_WEBHOOK_SECRET=<webhook-secret>
